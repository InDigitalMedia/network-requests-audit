.DS_Store
__pycache__/
*.pyc

# scripts/network-guard.sh's one-time local Playwright install for the
# dynamic half of the network-isolation guard - deliberately not committed,
# no package.json involved, see the script's own header comment.
.guard-deps/

# Per-user BMAD install config — regenerated by the installer, scoped to one
# person's local answers. See _bmad/custom/.gitignore for the same pattern
# applied to _bmad/custom/.
_bmad/config.user.toml
