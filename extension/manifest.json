{
  "manifest_version": 3,
  "name": "In Digital – Check tracking",
  "short_name": "Check tracking",
  "version": "1.0.0",
  "description": "Lists the marketing tags (GA4, Google Ads, Meta, TikTok, LinkedIn and more) firing on the current page. Nothing leaves your browser.",
  "action": {
    "default_title": "Check tracking on this page",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "minimum_chrome_version": "111"
}
